# DataPilot AI — Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and replace placeholders with real keys.

# 1. Groq Cloud API Key (LLM Intelligence)
# Get your free key at https://console.groq.com
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# 2. Google OAuth 2.0 Client Credentials
# Set up in Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Application type: Web application
# Authorized redirect URIs: http://localhost:8501 (and your deployed domain, e.g. https://your-app.streamlit.app)
GOOGLE_CLIENT_ID = "your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your_google_client_secret_here"
GOOGLE_REDIRECT_URI = "http://localhost:8501"
